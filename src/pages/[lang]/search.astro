---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LOCALES, localizedPath, withBase } from '../../i18n/locales.js';
import { course } from '../../lib/course.js';
import { portal } from '../../lib/portal.js';
import { readFileSync, readdirSync } from 'node:fs';
import { join } from 'node:path';
export function getStaticPaths() { return LOCALES.map((lang) => ({ params: { lang } })); }
const { lang } = Astro.params;
const strip = (html) => html.replace(/<[^>]+>/g, ' ').replace(/&amp;/g, '&').replace(/&rarr;|→/g, '→').replace(/\s+/g, ' ').trim();
const slides = course.lectures.flatMap((lecture) => {
  const dir = join(process.cwd(), lecture.deckFile.replace(/\.html$/, ''), 'parts');
  const source = readdirSync(dir).filter((name) => name.endsWith('.html')).sort().map((name) => readFileSync(join(dir, name), 'utf8')).join('\n');
  return [...source.matchAll(/<section class="slide"[\s\S]*?<\/section>/g)].map(([html], index) => {
    const heading = strip((html.match(/<h2[^>]*>([\s\S]*?)<\/h2>/) || [,''])[1]);
    const label = (html.match(/data-screen-label="([^"]+)"/) || [,''])[1].replace(/^\d+\s*/, '');
    return { type: `Slide L${lecture.id}`, title: heading || label, text: strip(html), href: `${withBase('/' + lecture.deckFile)}#/${index}` };
  });
});
const items = [
  ...portal.topics.map((x) => ({ type: 'Topic', title: x.title, text: `${x.summary} ${x.outcomes.join(' ')} ${x.acceptance.join(' ')}`, href: localizedPath(lang, `topics/${x.id}`) })),
  ...portal.glossary.map(([term, definition]) => ({ type: 'Glossary', title: term, text: definition, href: localizedPath(lang, 'glossary') })),
  ...course.reading.map((x) => ({ type: 'Reading', title: x.title, text: `${x.author} ${x.publisher || ''}`, href: x.url })),
  ...slides,
];
---
<BaseLayout lang={lang} page="search" title="Search">
  <div class="wrap"><section class="block"><h1>Search course materials</h1><p class="sub">Searches slide text, published topic contracts, glossary definitions, and required reading.</p><label class="search-label" for="course-search">Search</label><input id="course-search" class="search-input" type="search" placeholder="prefill, timeout, roofline…" autofocus /></section>
  <section class="block"><p id="result-count" class="kicker">{items.length} indexed entries</p><div class="search-results" id="search-results">{items.map((item) => <article class="search-result" data-search={`${item.title} ${item.text}`.toLowerCase()}><span class="state state-ready">{item.type}</span><h2><a href={item.href}>{item.title}</a></h2><p>{item.text}</p></article>)}</div><p id="search-empty" hidden>No matching course material.</p></section></div>
  <script is:inline>
    const input = document.querySelector('#course-search'); const entries = [...document.querySelectorAll('.search-result')]; const count = document.querySelector('#result-count'); const empty = document.querySelector('#search-empty');
    input?.addEventListener('input', () => { const words = input.value.toLowerCase().trim().split(/\s+/).filter(Boolean); let shown = 0; entries.forEach((el) => { el.hidden = !words.every((word) => el.dataset.search.includes(word)); if (!el.hidden) shown++; }); count.textContent = `${shown} matching entries`; empty.hidden = shown !== 0; });
  </script>
</BaseLayout>
