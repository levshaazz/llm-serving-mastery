---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LOCALES, t, withBase } from '../../i18n/locales.js';
import { ui } from '../../i18n/ui.js';
import { course } from '../../lib/course.js';
import { thresholds, rounds, standings } from '../../lib/leaderboard.js';

export function getStaticPaths() {
  return LOCALES.map((l) => ({ params: { lang: l } }));
}
const { lang } = Astro.params;
const lb = course.leaderboard;
const L = ui.leaderboardPage;
const table = standings();
const scoring = [
  [L.deadline, lb.deadline],
  [L.contract, L.contractRule],
  [L.quality, lb.quality],
  [L.latency, lb.latency],
  [L.sameModel, lb.canaryRule],
  [L.speed, lb.speed],
  [L.marks, lb.marks],
  [L.bars, lb.thresholds],
  [L.overdrive, lb.overdrive],
  [L.exemption, lb.exemption],
  [L.dryRun, lb.dryRun],
];
const pct = (x) => (x * 100).toFixed(1) + '%';
---
<BaseLayout lang={lang} page="leaderboard" title={t(ui.nav.leaderboard, lang)}>
  <div class="cover-banner">
    <img src={withBase('/Lectures/assets/img/L0/L0-05-scoreboard.webp')} alt="Three student cooks racing at three stoves while Serega judges with a stopwatch in front of a scoreboard" />
  </div>
  <div class="wrap">
    <section class="block">
      <h1>{t(ui.sections.leaderboard, lang)}</h1>
      <div class="kicker">{lb.rounds} {t(ui.labels.rounds, lang)} · {t(lb.deadline, lang)}</div>
      <p class="notice">{t(lb.thresholds, lang)}</p>
      <div class="meta">
        <div><div class="k">{t(ui.labels.judge, lang)}</div><div class="v">{t(lb.judge, lang)}</div></div>
        <div><div class="k">{t(ui.labels.devBox, lang)}</div><div class="v">{t(lb.devBox, lang)}</div></div>
      </div>
    </section>

    <section class="block">
      <h2>{t(L.barsTitle, lang)}</h2>
      <div class="kicker">{t(L.barsKicker, lang)}</div>
      <table>
        <thead><tr><th>{t(ui.labels.round, lang)}</th><th>GSM8K ≥</th><th>IFEval ≥</th><th>MMLU-Pro ≥</th><th>p95 TTFT@64 ≤</th><th>S_bar</th><th>{t(ui.labels.source, lang)}</th></tr></thead>
        <tbody>
          {thresholds.map((th) => (
            <tr>
              <td>{th.round}</td>
              <td class="d">{pct(th.quality_gates.gsm8k)}</td>
              <td class="d">{pct(th.quality_gates.ifeval)}</td>
              <td class="d">{pct(th.quality_gates.mmlu_pro)}</td>
              <td class="d">{th.ttft_p95_slo_s} s</td>
              <td class="d"><strong>{th.speed_bar_S} tok/s</strong></td>
              <td>{th.verified === false ? `PROVISIONAL — ${th.note}` : th.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="block">
      <h2>{t(ui.sections.board, lang)}</h2>
      <div class="kicker">{t(L.boardKicker, lang)}</div>
      <table>
        <thead><tr><th>#</th><th>GitHub</th><th>{t(ui.labels.rounds, lang)}</th><th>{t(L.points, lang)}</th><th>Overdrive</th></tr></thead>
        <tbody>
          {table.length === 0 && <tr><td colspan="5" style="color:var(--ink-3);font-weight:400">{t(L.empty, lang)}</td></tr>}
          {table.map((s, i) => (
            <tr><td>{i + 1}</td><td>{s.student}</td><td class="d">{s.rounds}</td><td class="d">{s.points.toFixed(1)} / 40</td><td class="d">{s.overdrive}{s.overdrive >= 10 ? ' ✓' : ''}</td></tr>
          ))}
        </tbody>
      </table>
      {rounds.map((r) => (
        <details style="margin-top:var(--ws-3)">
          <summary>{t(ui.labels.round, lang)} {r.round}</summary>
          <table>
            <thead><tr><th>#</th><th>GitHub</th><th>S</th><th>{t(L.mark, lang)}</th><th>Overdrive</th><th>{t(L.why, lang)}</th></tr></thead>
            <tbody>
              {r.rows.map((row) => (
                <tr><td>{row.rank ?? '—'}</td><td>{row.student}</td><td class="d">{row.S}</td><td class="d">{row.mark}</td><td class="d">+{row.overdrive}</td><td>{row.reasons.join('; ')}</td></tr>
              ))}
            </tbody>
          </table>
        </details>
      ))}
    </section>

    <section class="block">
      <h2>{t(ui.sections.contract, lang)}</h2>
      <p>{t(lb.submission, lang)} <a href={`${course.meta.repo}/tree/main/submission-template`}>submission-template</a> · <a href={`${course.meta.repo}/tree/main/judge`}>judge</a></p>
      <table>
        <thead><tr><th>{t(ui.labels.file, lang)}</th><th>{t(ui.labels.role, lang)}</th></tr></thead>
        <tbody>{lb.contract.map((c) => <tr><td class="d">{c.file}</td><td>{t(c.role, lang)}</td></tr>)}</tbody>
      </table>
      <p><strong>{t(ui.labels.model, lang)}:</strong> {t(lb.modelRule, lang)}</p>
      <p><strong>{t(ui.labels.stack, lang)}:</strong> {t(lb.stackRule, lang)}</p>
    </section>

    <section class="block" style="border-bottom:none">
      <h2>{t(ui.sections.scoring, lang)}</h2>
      <div class="kicker">{t(lb.ranking, lang)}</div>
      <table>
        <thead><tr><th>{t(ui.labels.step, lang)}</th><th>{t(ui.labels.rule, lang)}</th></tr></thead>
        <tbody>{scoring.map(([k, v]) => <tr><td>{t(k, lang)}</td><td>{t(v, lang)}</td></tr>)}</tbody>
      </table>
      <p><strong>{t(ui.labels.policy, lang)}:</strong> {t(course.assessment.policy, lang)}</p>
    </section>
  </div>
</BaseLayout>
